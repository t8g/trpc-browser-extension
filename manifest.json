{
  "manifest_version": 3,
  "name": "tRPC DevTools",
  "short_name": "tRPC",
  "version": "0.1.0",
  "description": "Panneau DevTools qui capture les requêtes tRPC et affiche proprement leurs résultats (batch, superjson, erreurs).",
  "devtools_page": "devtools.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trpc-devtools@t8g",
      "strict_min_version": "115.0"
    }
  }
}
